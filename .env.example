# Copy to .env and set a real value before running `docker compose up`.
# Authenticates LiteLLM's own admin/API routes, and (since the MCP gateway
# was wired up) admission to its /mcp endpoint too, via the x-litellm-api-key
# header -- callers send this to reach the wrapped Tier 0/1 MCP tools at all.
# This does NOT make Tier 0 itself require auth: nginx's :8080 direct HTTP
# catalog stays exactly as open as before (see ARCHITECTURE.md) -- the MCP
# endpoint is an additional, keyed front door alongside it, not a
# replacement for it.
LITELLM_MASTER_KEY=sk-changeme

# Gates the admin UI (admin/) — a separate secret from LITELLM_MASTER_KEY:
# different service, different risk surface (this one gates catalog WRITES
# and, since Tier 2 client management was added, full realm-admin access to
# Keycloak — see KEYCLOAK_ADMIN_* below).
ADMIN_UI_USERNAME=admin
ADMIN_UI_PASSWORD=changeme

# Keycloak's bootstrap realm-admin account. Used by both the `keycloak`
# service itself (to create the account) and the admin UI (to manage Tier 2
# partner OAuth clients via Keycloak's Admin REST API) — one shared
# credential, since both sides of that relationship are this project's own
# services. This became a sensitive credential the moment admin/ started
# using it programmatically; previously it was a hardcoded admin/admin dev
# default in docker-compose.yml.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# Must match the audience keycloak/realm-export.json's example-partner
# client already mints and verify/keycloak_auth.py already expects — every
# client the admin UI creates mints this exact audience too. Also, since the
# Tier 3 demo, this is the clientId of keycloak/realm-export.json's second
# client, agent-embassy-tier2 (verify/introspection.py uses it to call
# Keycloak's token-introspection endpoint) — Keycloak requires the
# introspecting client's own clientId to be present in the token's aud
# claim, and every partner token already carries this value. Only override
# if you've also changed it in all of those places.
TIER2_AUDIENCE=agent-embassy-tier2

# Shared secret between the admin UI and verify, gating verify's
# /tier1/admin-config endpoint (hot-reloading Tier 1's TTLs/rate limits) and
# (since the Tier 3 demo) the /tier3/admin-grants and /tier3/admin-audit
# endpoints. verify has no published host port, so this isn't reachable
# from outside docker either way, but these endpoints mutate limits/read
# audit data for every Tier 1/3 caller, which is a more consequential
# surface than that alone should guard. Generate with e.g. `openssl rand
# -hex 32`.
ADMIN_INTERNAL_TOKEN=changeme

# Tier 3 demo only: the client-secret credential for the
# agent-embassy-tier2 client in keycloak/realm-export.json — verify uses it
# to authenticate to Keycloak's token-introspection endpoint (RFC 7662),
# the mechanism that makes Tier 3 revocation immediate instead of waiting
# for a token's natural expiry (Tier 2's accepted tradeoff). Must match the
# "secret" field of that realm-export.json client exactly.
TIER3_INTROSPECTION_SECRET=agent-embassy-tier2-dev-secret-changeme

# --- The privileged internal agent (see ARCHITECTURE.md) ---
# UPGRADING AN EXISTING CHECKOUT: the two AGENT_* tokens below are new
# required values — `docker compose config`/`up` fails loudly (by design,
# before any service starts) until you add them to your .env. Generate each
# with e.g. `openssl rand -hex 32`.

# Shared secret between verify and the internal agent, authorizing Tier 3
# action handoffs (verify -> agent's /internal/actions). Deliberately a
# DIFFERENT secret from ADMIN_INTERNAL_TOKEN: this one authorizes
# execution, and the agent must never hold a token verify itself accepts.
AGENT_INTERNAL_TOKEN=changeme

# Shared secret between the admin UI and the internal agent, authorizing
# READ-ONLY status/decision-log access (admin -> agent's /internal/status).
# A third secret, not either of the above: the admin UI must be
# structurally unable to invoke the agent's execution endpoint, and the
# agent must hold nothing that grants authority over verify.
AGENT_STATUS_TOKEN=changeme

# OPTIONAL: the internal agent's LLM-assisted channel choice. Leave both
# unset and the agent runs rules-only (agent/rules.json alone decides;
# actions no rule covers are refused, never guessed). To enable: set
# AGENT_LLM_MODEL to "internal-agent-default" (litellm/config.yaml's
# model_list entry, Anthropic claude-haiku-4-5) and provide your own
# Anthropic API key — LLM usage is billed to this key.
AGENT_LLM_MODEL=
ANTHROPIC_API_KEY=

# --- Production only (docker-compose.prod.yml) ---
# Everything below is unused by plain `docker compose up` (local dev) and
# only required when running with `-f docker-compose.prod.yml` — see
# README's "Running a production pilot deployment" section.

# The real hostname partners will reach Keycloak at (fronted by nginx, see
# nginx/tls-listeners.conf's :8444 /keycloak/... proxy locations). Required
# by Keycloak's own `start` (non-dev) command, which refuses to boot
# without an explicit hostname decision.
KEYCLOAK_HOSTNAME=

# Postgres, Keycloak's production database (dev mode uses an embedded
# store instead, which Keycloak's own docs mark unsupported for real use).
POSTGRES_PASSWORD=

# A scoped OpenBao token (NOT the root token, NOT an unseal key) that lets
# the admin UI mirror Tier 2 partner client secrets into OpenBao's KV v2
# store as a backup of what Keycloak already holds as the source of truth.
# Minted via the one-time openbao/SETUP.md runbook. Local dev's admin
# service never sets this — OpenBao writes are simply skipped (a no-op,
# not an error) when it's unset, so local dev needs no OpenBao setup at
# all unless you want to exercise this path against OpenBao's dev-mode
# container manually.
#
# Leave this unset for the FIRST `docker compose ... up` in production too
# — it genuinely can't be set any earlier, since minting it requires a
# running `openbao` container in the first place (see README's "Running a
# production pilot deployment" step 3). Set it after running
# openbao/SETUP.md, then `docker compose ... up -d admin` (NOT `restart` --
# confirmed live, 2026-08-12: `restart` doesn't reread `.env`/recreate the
# container, so it silently leaves this empty) to pick it up.
OPENBAO_TOKEN=
